/* ===================== ROUTE COST ===================== */
static inline int edgeCost(int u, int v, int goal) {
  int c = 10;

  if (v == 0 || v == 2) c -= HUB_PREFERENCE_BONUS;
  if (v == 6 && goal != 6) c += NODE6_PENALTY_COST;

  if (u == 4 && v == 3) c += EDGE_4_TO_3_PENALTY_COST;

  if (c < 1) c = 1;
  return c;
}

/* ===================== LED helpers ===================== */
static inline void nodeLedOnPulse() {
  digitalWrite(NODE_LED_PIN, NODE_LED_ACTIVE_HIGH ? HIGH : LOW);
  nodeLedOffAt = millis() + NODE_LED_ON_MS;
}
static inline void nodeLedTick() {
  if (nodeLedOffAt && millis() > nodeLedOffAt) {
    digitalWrite(NODE_LED_PIN, NODE_LED_ACTIVE_HIGH ? LOW : HIGH);
    nodeLedOffAt = 0;
  }
}

/* ===================== WIFI / HTTP ===================== */
void connectToWiFi(uint32_t timeoutMs) {
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.disconnect(true, true);
  delay(150);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  uint32_t start = millis();
  while (WiFi.status() != WL_CONNECTED && (millis() - start) < timeoutMs) {
    delay(150);
  }
}

bool ensureWiFi() {
  if (WiFi.status() == WL_CONNECTED) return true;
  connectToWiFi();
  return (WiFi.status() == WL_CONNECTED);
}

bool httpConnect() {
  if (!ensureWiFi()) return false;
  if (client.connected()) { client.stop(); delay(20); }
  return client.connect(API_HOST, API_PORT);
}

void httpStop() {
  if (client.connected()) { client.stop(); delay(20); }
}

String readHTTPResponse() {
  String response = "";
  uint32_t startTime = millis();
  while (millis() - startTime < HTTP_TIMEOUT_MS) {
    while (client.available()) response += (char)client.read();
    if (!client.connected() && response.length() > 0) break;
    delay(5);
  }
  return response;
}

String extractBody(const String& response) {
  int bodyStart = response.indexOf("\r\n\r\n");
  if (bodyStart == -1) return response;
  String body = response.substring(bodyStart + 4);
  body.trim();
  return body;
}

String apiPostArrived(int position) {
  if (!httpConnect()) return "";

  String postData = "position=" + String(position);

  String request = String("POST /api/arrived/") + TEAM_ID + " HTTP/1.1\r\n";
  request += "Host: " + String(API_HOST) + "\r\n";
  request += "Content-Type: application/x-www-form-urlencoded\r\n";
  request += "Content-Length: " + String(postData.length()) + "\r\n";
  request += "Connection: close\r\n\r\n";
  request += postData;

  client.print(request);
  client.flush();

  String body = extractBody(readHTTPResponse());
  httpStop();
  return body;
}

bool isFinishedMessage(String s) {
  s.trim();
  s.toLowerCase();
  return (s == "finished");
}

/* ===================== SETUP ===================== */
void setup() {
  Serial.begin(115200);
  delay(600);

  pinMode(MOTOR1_PWM, OUTPUT);
  pinMode(MOTOR1_PHASE, OUTPUT);
  pinMode(MOTOR2_PWM, OUTPUT);
  pinMode(MOTOR2_PHASE, OUTPUT);

  for (int i = 0; i < NUM_SENSORS; i++) pinMode(ANALOG_PIN[i], INPUT);

  digitalWrite(MOTOR1_PHASE, HIGH);
  digitalWrite(MOTOR2_PHASE, HIGH);

  pinMode(NODE_LED_PIN, OUTPUT);
  digitalWrite(NODE_LED_PIN, NODE_LED_ACTIVE_HIGH ? LOW : HIGH);

  // Ultrasonic disabled by default
  pinMode(US_TRIG_PIN, OUTPUT);
  pinMode(US_ECHO_PIN, INPUT);
  digitalWrite(US_TRIG_PIN, LOW);
  ultrasonicEnabled = false;

  connectToWiFi();
  if (WiFi.status() != WL_CONNECTED) {
    delay(1500);
    ESP.restart();
  }
  //servo initialisation
  leftServo.setPeriodHertz(50); // PWM frequency for SG90
  leftServo.attach(leftServoPin, 500, 2400); // Minimum and maximum pulse width (in µs) to go from 0° to 180
  rightServo.setPeriodHertz(50); // PWM frequency for SG90
  rightServo.attach(rightServoPin, 500, 2400); // Minimum and maximum pulse width (in µs) to go from 0° to 180

  //Display initialisation
  // Start I2C with chosen pins
  Wire.begin(SDA_PIN, SCL_PIN);

  // Initialize OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED not found");
    while (true);
  }
  //music pin
  pinMode(musicPin, OUTPUT);
  digitalWrite(musicPin, HIGH);//set the music to start

  Serial.println("Robot Ready - Ultrasonic DISABLED (will activate only for parking)");
}

void tiltLeft() {
  leftServo.write(180);
  rightServo.write(180);
  delay(10);
}

void tiltRight() {
  leftServo.write(0);
  rightServo.write(0);
  delay(10);
}

void straighten() {
  leftServo.write(90);
  rightServo.write(90);
  delay(10);
}

void celebrate() {
  for (int i = 0; i < 5; i++) {

    leftServo.write(180);
    rightServo.write(0);
    delay(500);

    leftServo.write(0);
    rightServo.write(180);
    delay(500);

    tiltLeft();
    delay(500);

    tiltRight();
    delay(500);
  }
}

void servoTilt() {
  if (navigating == true) {
    switch(currentNode) {
      case 0:
        if (clockwise == true) {straighten();}
        else {tiltLeft();}
        break;
      case 1:
        straighten();
        break;
      case 2:
        if (clockwise == true) {tiltRight();}
        else {straighten();}
        break;
      case 3:
        if (clockwise == true) {straighten();}
        else {tiltLeft();}
        break;
      case 4:
        if (clockwise == true) {tiltRight();}
        else {straighten();}
        break;
      case 5:
        if (clockwise == true) {tiltRight();}
        else {tiltLeft();}
        break;
      case 6:
        if (clockwise == true) {tiltRight();}
        else {tiltLeft();}
        break;
    }
  }
}

