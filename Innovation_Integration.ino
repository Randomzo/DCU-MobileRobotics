// ---------- DYNAMIC BLOCKED EDGES (persist until reboot) ----------
static bool blockedEdge[NUM_NODES][NUM_NODES] = { false };

// Block both directions so the robot never uses that physical segment again
static inline void blockEdgeBothWays(int u, int v) {
  if (u < 0 || u >= NUM_NODES || v < 0 || v >= NUM_NODES) return;
  blockedEdge[u][v] = true;
  blockedEdge[v][u] = true;
}

static inline bool isEdgeBlocked(int u, int v) {
  if (u < 0 || u >= NUM_NODES || v < 0 || v >= NUM_NODES) return true;
  return blockedEdge[u][v];
}


